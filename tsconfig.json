{
	"compilerOptions": {
		// Environment setup & latest features
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"allowJs": true,
		"types": ["bun"],

		// Bundler mode
		"moduleResolution": "bundler",
		"paths": {
			"kreb": ["./packages/kreb/src/index.ts"],
			"kreb/*": ["./packages/kreb/src/*.ts"],
			"@kreb/math": ["./packages/kreb-math/src/index.ts"],
			"@kreb/math/*": ["./packages/kreb-math/src/*.ts"],
			"@kreb/raylib-sys": ["./packages/raylib-sys/src/index.ts"],
			"@kreb/raylib-sys/build": ["./packages/raylib-sys/scripts/build-shim.ts"],
			"@kreb/raylib-sys/codegen/*": ["./packages/raylib-sys/tools/codegen/*.ts"],
			"@kreb/raylib-sys/raylib": ["./packages/raylib-sys/generated/raylib.ts"],
			"@kreb/raylib-sys/colors": ["./packages/raylib-sys/generated/colors.ts"],
			"@kreb/raylib-sys/enums": ["./packages/raylib-sys/generated/enums.ts"],
			"@kreb/raylib-sys/*": ["./packages/raylib-sys/src/*.ts"]
		},
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		// Best practices
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,

		// Some stricter flags (disabled by default)
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noPropertyAccessFromIndexSignature": false
	}
}
